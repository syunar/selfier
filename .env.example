PRIMARY_ENV=production
SERVER_PORT=9090
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15
SERVER_IDLE_TIMEOUT=60
SERVER_CORS_ALLOWED_ORIGINS="http://localhost:3000,https://my-app.com"

# Database - Supabase PostgreSQL (Recommended)
# Get these from Supabase Project Settings > Database > Connection String
DATABASE_HOST=db.xxxxxxxxxxxxx.supabase.co
DATABASE_PORT=6543  # Use 6543 for connection pooling (recommended for serverless)
DATABASE_USER=postgres
DATABASE_PASSWORD="your_supabase_db_password"
DATABASE_NAME=postgres
DATABASE_SSL_MODE=require
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=300
DATABASE_CONN_MAX_IDLE_TIME=120

# For Next.js/Prisma (required for web frontend)
DATABASE_URL="postgresql://postgres:your_supabase_db_password@db.xxxxxxxxxxxxx.supabase.co:6543/postgres"

REDIS_ADDRESS="redis-prod:6379"
REDIS_PASSWORD=""

AUTH_SECRET_KEY="a-very-long-and-secure-random-string-for-jwt"

AWS_REGION=us-east-1
